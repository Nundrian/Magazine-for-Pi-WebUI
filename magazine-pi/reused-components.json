  "pi6_adaptation": {
    "source_repository": "https://github.com/Nundrian/Magazine",
    "source_commit": "09a8706e5f01fe6d8db0b8941ccf0d772b374005",
    "source_file": "integrations/open_webui/function/magazine_simple_reliability3.py",
    "source_sha256": "28a9f3172192efbd7219a017bdfe7e2d5737882d9b0e3684478bdfc367ec730b",
    "source_version": "0.2.0-reliability.3",
    "adapted": {
      "protocol.py": [
        "recovery_policy (verbatim semantics)",
        "loop_policy (verbatim semantics)",
        "load_workflow declarations (handover, artifacts, retry_safe, handover_mode, result_profile)",
        "json_objects/closing_object/halt_reason/judge (Pi stop-reason facts instead of Open WebUI output items)",
        "result_json",
        "select_pointer"
      ],
      "handover.py": [
        "strict_json",
        "durable_json",
        "read_result_file",
        "validate_outgoing",
        "validate_envelope (chat_id -> session_id)",
        "commit_attempt_result",
        "committed_result -> committed_payload",
        "archive_attempt_chat -> archive_session",
        "prepare_files",
        "collect_outputs",
        "snapshot_candidates"
      ],
      "ledger.py": [
        "decide_retry (Pi completion codes added explicitly)",
        "retry_text",
        "sum_tokens/update_tokens semantics",
        "render_ledger (Pi columns)"
      ],
      "antiloop.py": [
        "LoopPolice/completed_tool_events (Open WebUI polling replaced by Pi SDK message_end/tool_execution_end events)"
      ],
      "executor.py": [
        "execute_file_run attempt loop and fingerprints",
        "result_prompt/build_prompt (publisher tool instead of a Python helper script)",
        "attempt_chat timeout/loop handling",
        "retry_storage"
      ],
      "worker.mjs": [
        "PUBLISH_HELPER semantics as a capability-limited Pi custom tool (magazine_publish_result)"
      ]
    },
    "not_used": [
      "Open WebUI HTTP client, routes, authentication, chat creation/polling, task stop API, Engine queue, page HTML, Sidebar launcher, Round Robin/queue scheduler"
    ]
  },
  "pi7_scheduler": {
    "source": "Magazine Simple 0.3.0-scheduler.rc1",
    "source_zip_sha256": "b2acaad4a27260b163b87d732fb38886c90623f72b249683efebab93cab81864",
