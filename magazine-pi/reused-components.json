    "adapted": {
      "scheduler.py": [
        "Engine journal load/_persist/set_mode",
        "start (admission) -> admit",
        "_next -> pump",
        "boundary -> turn",
        "finished",
        "dequeue",
        "mark_interrupted retention -> needs_start entries"
      ],
      "client/entry.mjs": [
        "dashboard.js restoration order and project summary",
        "ledger.js six-column overview with lazy attempt details and filter"
      ],
